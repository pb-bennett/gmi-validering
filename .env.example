# Supabase-prosjekt for aggregert bruksstatistikk (server-side).
SUPABASE_URL=

# Supabase service-nøkkel; skal kun være tilgjengelig på serversiden.
SUPABASE_SERVICE_ROLE_KEY=

# Hemmelig beskyttelse for tracking-keepalive; server-side.
TRACKING_KEEPALIVE_SECRET=

# Valgfri lagringssti for lokal statistikkfallback (server-side).
TRACKING_STORAGE_PATH=

# Resend API-nøkkel for kontaktlevering; skal kun være tilgjengelig på serversiden.
RESEND_API_KEY=

# Mottaker- og avsenderadresse for kontaktmeldinger; server-side konfigurasjon.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
